[] a dcat:Dataset ;
    dcterms:accessRights <http://purl.org/coar/access_right/c_f1cf> ;
    dcterms:title "Datová sada pro Údaje o zdravotní gramotnosti a depresi seniorů ve věku 65 a více let"^^xsd:string ;
    ns1:identifier <https://doi.org/10.48700/datst.xd12h-dfz24> ;
    prov:qualifiedAttribution [ a prov:Attribution ;
            dcat:hadRole <https://vocabs.ccmm.cz/registry/codelist/AgentRole/Creator> ;
            prov:agent [ a prov:Person ;
                    ns2:family-name "Bártlová"^^xsd:string ;
                    ns2:given-name "Sylva"^^xsd:string ;
                    foaf:name "Bártlová, Sylva"^^xsd:string ] ],
        [ a prov:Attribution ;
            dcat:hadRole <https://vocabs.ccmm.cz/registry/codelist/AgentRole/Publisher> ;
            prov:agent [ a org:Organization ;
                    foaf:name ":unkn"^^xsd:string ] ] ;
    ns0:hasTimeReference [ a ns0:TimeReference ;
            time:hasTime [ a time:Instant ;
                    time:inXSDDate "2024-05-01"^^xsd:date ] ;
            ns0:hasType <https://vocabs.ccmm.cz/registry/codelist/TimeReference/Created> ] ;
    ns0:isDescribedBy [ a dcat:CatalogRecord ;
            dcterms:conformsTo <https://model.ccmm.cz/research-data/2.0.0> ;
            dcterms:modified "2025-07-25"^^xsd:date ;
            prov:qualifiedAttribution [ a prov:Attribution ;
                    dcat:hadRole <https://vocabs.ccmm.cz/registry/codelist/AgentRole/Contributor/DataManager> ;
                    prov:agent [ a prov:Person ;
                            ns2:family-name ":unkn"^^xsd:string ;
                            ns2:given-name ":unkn"^^xsd:string ;
                            foaf:name ":unkn"^^xsd:string ] ] ;
            ns0:originalRepository <https://data.narodni-repozitar.cz> ] ;
    ns5:description [ a <https://w3id.org/tib/datacite/class/Description> ;
            dcterms:description "Toto je jen ukázka metadat pro neexistující datovou sadu."@cs ] ;
    ns5:publicationYear "2026"^^xsd:gYear ;
    ns5:subject <https://vocabs.ccmm.cz/registry/codelist/SubjectCategory/30000/30300/30304> .

