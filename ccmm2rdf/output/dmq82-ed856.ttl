    ns0:inScheme <https://doi.org/> ;
    ns0:isDescribedBy <https://datarepo.eosc.cz/datasets/records/datst.dmq82-ed856> ;
    ns5:description [ a <https://w3id.org/tib/datacite/class/Description> ;
            dcterms:description "The sets of experimental data were recorded on several instruments within COMTES FHT. In cases where possible (XRD, MTT, EBSD), the data are in xlsx format enabling any replotting."@en ;
            ns5:descriptionType <https://vocabs.ccmm.cz/registry/codelist/DescriptionType/TechnicalInfo> ],
        [ a <https://w3id.org/tib/datacite/class/Description> ;
            dcterms:description "Industry applications of duplex stainless steels require a two-phase microstructure with a nearly balanced austenite-ferrite content to achieve good mechanical properties and good corrosion resistance. The most widespread additive manufacturing method such as laser powder bed fusion provides nearly fully ferritic microstructures due to the very high cooling rate, and the post-processing heat treatment must be performed. In contrast, other additive manufacturing methods, such as directed deposition methods, reach lower cooling rates and enable to obtain an equal ferrite–austenite ratio directly in the microstructure of the as-built state. In this work, the super duplex stainless steel SAF 2507 was deposited by directed energy deposition. The process parameters, namely, the laser power, laser beam spot, and powder feed rate, were varied to investigate the impact of the energy area density on the microstructure and tensile properties. A decrease in the energy area density caused an increase in the austenite content of 48 vol% and a numerical simulation of the sample temperature distribution inside the block during deposition, explaining the relationship between the amount of in situ formed austenite and the deposition parameters, was provided. Simultaneously, the deposition rate increased by more than five times. In contrast, the samples deposited at a higher building rate are characterized by greater porosity and lower elongation values in the vertical direction. The effect of the deposition parameters on the yield strength is low."@en ;
            ns5:descriptionType <https://vocabs.ccmm.cz/registry/codelist/DescriptionType/Abstract> ],
        [ a <https://w3id.org/tib/datacite/class/Description> ;
            dcterms:description "The data set is related to the investigation of the influence of deposition parameters on the microstructure, austenite formation, and tensile properties of SAF 2507 super duplex stainless steel fabricated using directed energy deposition (DED). The experiments were carried out at COMTES FHT (Czech Republic) using an INSSTEK MX-600 system equipped with a 2 kW Yttrium fiber laser. SAF 2507 powder (particle size 45–150 μm) was deposited under three different parameter sets, varying laser power, beam diameter, layer thickness, hatch distance, and powder feed rate, while maintaining constant scan speed. A zig-zag deposition strategy was applied under a protective argon atmosphere (5.0, 99.999%). For each parameter set, 20×20×20 mm cubes were built and used for analysis. Microstructure and phase composition were characterized using optical microscopy, scanning electron microscopy, EBSD analysis, X-ray diffraction. Tensile properties were evaluated using miniature tensile tests. Thermal simulations of the deposition process were carried out using Simufact Welding 2024.1 with the Advanced Thermal Cycle (ATC) method."@en ;
            ns5:descriptionType <https://vocabs.ccmm.cz/registry/codelist/DescriptionType/Methods> ] ;
    ns5:fundingReference [ a <https://w3id.org/tib/datacite/class/FundingReference> ;
            ns0:fundingProgram "Operační program Jan Amos Komenský"^^xsd:anyURI ;
            ns5:awardNumber "EH23_021/0008433"^^xsd:string ;
            ns5:awardTitle "Development of special wire semiproducts for welding and 3D printing"^^xsd:string ;
            ns5:funderIdentifier [ a org:Organization ;
